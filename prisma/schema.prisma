generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PRESIDENT
  VP
  MEMBER
}

enum SubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  DENIED
}

enum MailboxStatus {
  PROVISIONED_AWAITING_PASSWORD
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

enum EmailRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MailAuditAction {
  EMAIL_REQUEST_CREATED
  EMAIL_REQUEST_EDITED
  EMAIL_REQUEST_APPROVED
  EMAIL_REQUEST_REJECTED
  EMAIL_REQUEST_CANCELLED
  MAILBOX_PROVISIONED
  MAILBOX_PROVISION_FAILED
  PASSWORD_SETUP_TOKEN_ISSUED
  PASSWORD_SET_INITIAL
  PASSWORD_CHANGED
  PASSWORD_RESET_BY_ADMIN
  MAILBOX_SUSPENDED
  MAILBOX_UNSUSPENDED
  MAILBOX_DELETION_SCHEDULED
  MAILBOX_DELETED
}

model Member {
  id          String   @id @default(cuid())
  hackClubSub String   @unique @map("hack_club_sub")
  username    String?  @unique
  email       String   @unique
  name        String
  headline    String?
  bio         String?
  role            Role     @default(MEMBER)
  profilePictureKey String?  @map("profile_picture_key")
  headshotKey      String?  @map("headshot_key")
  hackatimeToken  String?  @map("hackatime_token")
  schoolEmail     String?  @map("school_email")
  websiteUrl      String?  @map("website_url")
  githubUrl       String?  @map("github_url")
  createdAt       DateTime @default(now()) @map("created_at")

  projects Project[]
  devlogs  Devlog[]
  attendanceRecords AttendanceRecord[]
  mailingListEntry  MailingListEntry[]
  mailbox       Mailbox?       @relation("MailboxOwner")
  emailRequests EmailRequest[] @relation("EmailRequestOwner")
  passwordSetupTokens PasswordSetupToken[] @relation("PasswordSetupTokenOwner")
  auditActed    MailAuditLog[] @relation("MailAuditActor")
  auditSubject  MailAuditLog[] @relation("MailAuditSubject")

  @@map("members")
}

model Project {
  id          String           @id @default(cuid())
  memberId    String           @map("member_id")
  title       String           @default("")
  description String           @default("")
  githubUrl        String?          @map("github_url")
  demoUrl          String?          @map("demo_url")
  tags             String[]         @default([])
  hackatimeProject String?          @map("hackatime_project")
  status      SubmissionStatus @default(DRAFT)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  images  Image[] @relation("ProjectImages")
  devlogs Devlog[]

  @@map("projects")
}

model Devlog {
  id        String           @id @default(cuid())
  memberId  String           @map("member_id")
  projectId String?          @map("project_id")
  title     String           @default("")
  body      String           @default("")
  status    SubmissionStatus @default(DRAFT)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  member  Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  images  Image[]  @relation("DevlogImages")

  @@map("devlogs")
}

model Image {
  id               String   @id @default(cuid())
  projectId        String?  @map("project_id")
  devlogId         String?  @map("devlog_id")
  minioKey         String   @map("minio_key")
  originalFilename String   @map("original_filename")
  createdAt        DateTime @default(now()) @map("created_at")

  project Project? @relation("ProjectImages", fields: [projectId], references: [id], onDelete: Cascade)
  devlog  Devlog?  @relation("DevlogImages", fields: [devlogId], references: [id], onDelete: Cascade)

  @@map("images")
}

model VerificationRequest {
  id          String             @id @default(cuid())
  hackClubSub String             @map("hack_club_sub")
  email       String
  name        String
  status      VerificationStatus @default(PENDING)
  createdAt   DateTime           @default(now()) @map("created_at")

  @@map("verification_requests")
}

model SiteModal {
  id        String   @id @default(cuid())
  title     String
  heading   String   @default("")
  body      String   @default("")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_modals")
}

model AttendanceRecord {
  id          String  @id @default(cuid())
  memberId    String  @map("member_id")
  date        DateTime @map("date")
  createdAt   DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@map("attendance_records")
}

model Meeting {
  id                   String    @id @default(cuid())
  title                String
  date                 DateTime
  notes                String?
  summary              String?
  materials            String?
  summaryReminderSentAt DateTime? @map("summary_reminder_sent_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("meetings")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  description String?
  location    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("events")
}

model MailingListEntry {
  id          String   @id @default(cuid())
  name        String
  schoolEmail String   @map("school_email")
  memberId    String?  @map("member_id")
  createdAt   DateTime @default(now()) @map("created_at")

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([schoolEmail])
  @@map("mailing_list_entries")
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  published Boolean   @default(false)
  emailedAt DateTime? @map("emailed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("announcements")
}

model Sponsor {
  id          String   @id @default(cuid())
  title       String
  linkUrl     String   @map("link_url")
  logoKey     String   @map("logo_key")
  description String?
  tier        String?
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sponsors")
}

model EmailRequest {
  id                  String             @id @default(cuid())
  memberId            String             @map("member_id")
  requestedLocalPart  String             @map("requested_local_part")
  domain              String             @default("phhshack.club")
  status              EmailRequestStatus @default(PENDING)
  adminOverride       Boolean            @default(false) @map("admin_override")
  adminOverrideReason String?            @map("admin_override_reason")
  rejectionReason     String?            @map("rejection_reason")
  lastError           String?            @map("last_error")
  reviewedByMemberId  String?            @map("reviewed_by_member_id")
  reviewedAt          DateTime?          @map("reviewed_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  member Member @relation("EmailRequestOwner", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([status])
  @@map("email_requests")
}

model Mailbox {
  id               String        @id @default(cuid())
  memberId         String        @unique @map("member_id")
  localPart        String        @map("local_part")
  domain           String        @default("phhshack.club")
  status           MailboxStatus
  purelymailUserId String?       @map("purelymail_user_id")
  provisionedAt    DateTime?     @map("provisioned_at")
  activatedAt      DateTime?     @map("activated_at")
  suspendedAt      DateTime?     @map("suspended_at")
  deleteAfter      DateTime?     @map("delete_after")
  deletedAt        DateTime?     @map("deleted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  member      Member               @relation("MailboxOwner", fields: [memberId], references: [id], onDelete: Restrict)
  setupTokens PasswordSetupToken[] @relation("MailboxSetupTokens")
  auditLogs   MailAuditLog[]       @relation("MailAuditMailbox")

  @@unique([localPart, domain])
  @@index([status])
  @@map("mailboxes")
}

model PasswordSetupToken {
  id               String    @id @default(cuid())
  memberId         String    @map("member_id")
  mailboxId        String    @map("mailbox_id")
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at")
  issuedByMemberId String?   @map("issued_by_member_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  member  Member  @relation("PasswordSetupTokenOwner", fields: [memberId], references: [id], onDelete: Cascade)
  mailbox Mailbox @relation("MailboxSetupTokens", fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([mailboxId])
  @@map("password_setup_tokens")
}

model MailAuditLog {
  id              String          @id @default(cuid())
  action          MailAuditAction
  actorMemberId   String?         @map("actor_member_id")
  subjectMemberId String?         @map("subject_member_id")
  mailboxId       String?         @map("mailbox_id")
  emailRequestId  String?         @map("email_request_id")
  metadata        Json?
  createdAt       DateTime        @default(now()) @map("created_at")

  actor   Member?  @relation("MailAuditActor", fields: [actorMemberId], references: [id], onDelete: SetNull)
  subject Member?  @relation("MailAuditSubject", fields: [subjectMemberId], references: [id], onDelete: SetNull)
  mailbox Mailbox? @relation("MailAuditMailbox", fields: [mailboxId], references: [id], onDelete: SetNull)

  @@index([subjectMemberId])
  @@index([createdAt])
  @@map("mail_audit_log")
}

model ReservedLocalPart {
  localPart String   @id @map("local_part")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reserved_local_parts")
}
