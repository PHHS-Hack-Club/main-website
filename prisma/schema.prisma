generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PRESIDENT
  VP
  MEMBER
}

enum SubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  DENIED
}

model Member {
  id          String   @id @default(cuid())
  hackClubSub String   @unique @map("hack_club_sub")
  username    String?  @unique
  email       String   @unique
  name        String
  headline    String?
  bio         String?
  role            Role     @default(MEMBER)
  profilePictureKey String?  @map("profile_picture_key")
  headshotKey      String?  @map("headshot_key")
  hackatimeToken  String?  @map("hackatime_token")
  schoolEmail     String?  @map("school_email")
  websiteUrl      String?  @map("website_url")
  githubUrl       String?  @map("github_url")
  createdAt       DateTime @default(now()) @map("created_at")

  projects Project[]
  devlogs  Devlog[]
  attendanceRecords AttendanceRecord[]
  mailingListEntry  MailingListEntry[]

  @@map("members")
}

model Project {
  id          String           @id @default(cuid())
  memberId    String           @map("member_id")
  title       String           @default("")
  description String           @default("")
  githubUrl        String?          @map("github_url")
  demoUrl          String?          @map("demo_url")
  tags             String[]         @default([])
  hackatimeProject String?          @map("hackatime_project")
  status      SubmissionStatus @default(DRAFT)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  images  Image[] @relation("ProjectImages")
  devlogs Devlog[]

  @@map("projects")
}

model Devlog {
  id        String           @id @default(cuid())
  memberId  String           @map("member_id")
  projectId String?          @map("project_id")
  title     String           @default("")
  body      String           @default("")
  status    SubmissionStatus @default(DRAFT)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  member  Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  images  Image[]  @relation("DevlogImages")

  @@map("devlogs")
}

model Image {
  id               String   @id @default(cuid())
  projectId        String?  @map("project_id")
  devlogId         String?  @map("devlog_id")
  minioKey         String   @map("minio_key")
  originalFilename String   @map("original_filename")
  createdAt        DateTime @default(now()) @map("created_at")

  project Project? @relation("ProjectImages", fields: [projectId], references: [id], onDelete: Cascade)
  devlog  Devlog?  @relation("DevlogImages", fields: [devlogId], references: [id], onDelete: Cascade)

  @@map("images")
}

model VerificationRequest {
  id          String             @id @default(cuid())
  hackClubSub String             @map("hack_club_sub")
  email       String
  name        String
  status      VerificationStatus @default(PENDING)
  createdAt   DateTime           @default(now()) @map("created_at")

  @@map("verification_requests")
}

model SiteModal {
  id        String   @id @default(cuid())
  title     String
  heading   String   @default("")
  body      String   @default("")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_modals")
}

model AttendanceRecord {
  id          String  @id @default(cuid())
  memberId    String  @map("member_id")
  date        DateTime @map("date")
  createdAt   DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@map("attendance_records")
}

model Meeting {
  id                   String    @id @default(cuid())
  title                String
  date                 DateTime
  notes                String?
  summary              String?
  materials            String?
  summaryReminderSentAt DateTime? @map("summary_reminder_sent_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("meetings")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  description String?
  location    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("events")
}

model MailingListEntry {
  id          String   @id @default(cuid())
  name        String
  schoolEmail String   @map("school_email")
  memberId    String?  @map("member_id")
  createdAt   DateTime @default(now()) @map("created_at")

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([schoolEmail])
  @@map("mailing_list_entries")
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  published Boolean   @default(false)
  emailedAt DateTime? @map("emailed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("announcements")
}

model Sponsor {
  id          String   @id @default(cuid())
  title       String
  linkUrl     String   @map("link_url")
  logoKey     String   @map("logo_key")
  description String?
  tier        String?
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sponsors")
}
