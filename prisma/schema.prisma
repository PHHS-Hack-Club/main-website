generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PRESIDENT
  VP
  MEMBER
}

enum SubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  DENIED
}

model Member {
  id          String   @id @default(cuid())
  hackClubSub String   @unique @map("hack_club_sub")
  email       String   @unique
  name        String
  role            Role     @default(MEMBER)
  profilePictureKey String?  @map("profile_picture_key")
  hackatimeToken  String?  @map("hackatime_token")
  createdAt       DateTime @default(now()) @map("created_at")

  projects Project[]
  devlogs  Devlog[]

  @@map("members")
}

model Project {
  id          String           @id @default(cuid())
  memberId    String           @map("member_id")
  title       String           @default("")
  description String           @default("")
  githubUrl        String?          @map("github_url")
  demoUrl          String?          @map("demo_url")
  tags             String[]         @default([])
  hackatimeProject String?          @map("hackatime_project")
  status      SubmissionStatus @default(DRAFT)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  images  Image[] @relation("ProjectImages")
  devlogs Devlog[]

  @@map("projects")
}

model Devlog {
  id        String           @id @default(cuid())
  memberId  String           @map("member_id")
  projectId String?          @map("project_id")
  title     String           @default("")
  body      String           @default("")
  status    SubmissionStatus @default(DRAFT)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  member  Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  images  Image[]  @relation("DevlogImages")

  @@map("devlogs")
}

model Image {
  id               String   @id @default(cuid())
  projectId        String?  @map("project_id")
  devlogId         String?  @map("devlog_id")
  minioKey         String   @map("minio_key")
  originalFilename String   @map("original_filename")
  createdAt        DateTime @default(now()) @map("created_at")

  project Project? @relation("ProjectImages", fields: [projectId], references: [id], onDelete: Cascade)
  devlog  Devlog?  @relation("DevlogImages", fields: [devlogId], references: [id], onDelete: Cascade)

  @@map("images")
}

model VerificationRequest {
  id          String             @id @default(cuid())
  hackClubSub String             @map("hack_club_sub")
  email       String
  name        String
  status      VerificationStatus @default(PENDING)
  createdAt   DateTime           @default(now()) @map("created_at")

  @@map("verification_requests")
}
